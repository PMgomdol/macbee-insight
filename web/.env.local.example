# ─────────────────────────────────────────────────────────────
# 맥비 자료실 환경변수 예시. 이 파일을 .env.local 로 복사해 값 채우기.
# NEXT_PUBLIC_ 접두어 = 브라우저 노출됨(공개값만). 그 외는 서버 전용(시크릿).
# Vercel 배포 시 동일 값을 Project Settings > Environment Variables 에 등록.
# ─────────────────────────────────────────────────────────────

# ── Supabase (SSOT DB + Storage) ──
# Supabase 대시보드 > Project Settings > Data API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# 서버 전용 — 절대 클라이언트/깃/슬랙 노출 금지
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret

# ── 사이트 ──
# 배포 후 자체 도메인 또는 vercel.app. 로컬은 http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── AI (자동 분류·요약) ──
# /submit 자료 자동 분석용 Gemini 키
GEMINI_API_KEY=your-gemini-key
# 대량 import·backfill 스크립트 전용 별도 Gemini 키(일일 쿼터 분리용, 선택)
GEMINI_IMPORT_KEY=your-gemini-import-key

# ── 분석: GA4 (유입 지표, 대시보드 읽기) ──
# gtag 수집 ID(G-...)는 코드에 하드코딩. 아래는 대시보드가 GA4 Data API로 읽을 때 필요.
GA_PROPERTY_ID=your-ga4-property-id
# GA4 뷰어 서비스계정 JSON을 base64로 인코딩한 문자열
GA_SERVICE_ACCOUNT_JSON=base64-encoded-service-account-json

# ── 분석: PostHog (행동 이벤트) ──
# 수집키(phc_) — 브라우저에서 이벤트 전송용(공개값)
NEXT_PUBLIC_POSTHOG_KEY=phc_your-project-key
# 읽기용 개인키(phx_) — 대시보드가 HogQL로 조회(서버 전용)
POSTHOG_PERSONAL_API_KEY=phx_your-personal-key
# PostHog 프로젝트 ID (미설정 시 코드 폴백값 사용)
POSTHOG_PROJECT_ID=your-project-id

# ── 메일 알림 (Apps Script MailApp 웹앱) ──
# 제안 등록·검수 알림 발송용 Apps Script 웹앱
MAIL_WEBAPP_URL=https://script.google.com/macros/s/xxx/exec
MAIL_WEBAPP_SECRET=your-shared-secret
MAIL_NOTIFY_TO=notify-recipient@example.com
