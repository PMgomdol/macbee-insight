# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# 예시 템플릿은 시크릿이 없으므로 추적 (신규 셋업·인수인계용)
!.env.local.example

# 스크린샷 도구의 날짜별 로컬 스냅샷 (반복 캡처가 git을 불리지 않게).
# before/after로 쓸 스냅샷은 public/changelog/ 로 영구 파일명으로 승격해서 커밋.
/public/changelog/_archive/
# 스크린샷 도구 로그인 세션 (민감정보)
/scripts/.shot-session.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
ins.html
s[0-9].html
